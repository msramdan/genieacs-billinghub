# BillingHub ACS — daftar server (hanya domain yang beda)
# Credentials disimpan terpisah / di password manager
#
# Deploy config identik:
#   sudo BH_ACS_HOST=<domain> bash scripts/sync-config.sh
#
# Kapita
BH_KAPITA_HOST=acs-kapita.billinghub.id
# Naam
BH_NAAM_HOST=acs.naam.co.id
# Annet
BH_ANNET_HOST=acs-annet.billinghub.id
# Lex
BH_LEX_HOST=acs-lex.billinghub.id
# Sama di semua server:
BH_ACS_PORT=7547
BH_ACS_USER=admin
BH_ACS_PASS=bilhub90
BH_UI_PASS=bilhub90
