# ============================================================
# ACS Studio - konfigurasi pusat (UI + setup aplikasi)
# ============================================================
# Salin file ini:
#   cp theme-studio/.env.example theme-studio/.env
# Lalu edit .env sesuai kebutuhan (jangan commit .env).
#
# Dipakai oleh:
#   - npm run dev / npm start (lokal)
#   - docker compose (AUTH_* dari .env; PORT Docker tetap 5173)

# Port API lokal (dev). Vite UI: http://127.0.0.1:5173 (proxy /api ke sini)
# Docker production memakai PORT=5173 (di docker-compose), abaikan nilai ini.
PORT=5174

# production | development
NODE_ENV=development

# Login halaman Masuk ACS Studio
AUTH_USER=admin
AUTH_PASS=billinghub01
