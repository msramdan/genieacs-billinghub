# ============================================================
# ACS Studio - konfigurasi pusat (UI + setup aplikasi)
# ============================================================
# Salin file ini:
#   cp theme-studio/.env.example theme-studio/.env
# Lalu edit .env sesuai kebutuhan (jangan commit .env).
#
# Dipakai oleh:
#   - npm run dev / npm start (lokal)
#   - docker compose (baca .env di folder theme-studio)

# Port HTTP ACS Studio
PORT=5173

# production | development
NODE_ENV=production

# Login halaman Masuk ACS Studio
AUTH_USER=admin
AUTH_PASS=billinghub01
