{
  "name": "acs-studio",
  "private": true,
  "version": "1.0.0",
  "description": "ACS Studio — local UI to deploy GenieACS BillingHub logo + color theme via SSH",
  "scripts": {
    "dev": "concurrently -n server,web -c teal,magenta \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "node-routeros": "^1.6.9",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  }
}
